# Database configuration
# For local MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/mazdoor

# Security settings
# You can generate a secure random secret using: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# OTP configuration (for development login)
OTP_EXPIRE_MINUTES=5
# Set to True to print OTPs in console for debugging/testing
DEBUG_OTP=True
